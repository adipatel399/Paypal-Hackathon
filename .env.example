PORT=3100
# demo is a local simulator. sandbox makes REAL PayPal sandbox API requests.
PAYMENT_MODE=demo
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Required in sandbox for organizer mutations; use a random value of 32+ characters.
ORGANIZER_TOKEN=
# Free AI: local Ollama by default. No cloud billing or API key required.
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:latest
# Optional Google AI Studio free-tier alternative. Do NOT enable paid billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FREE_TIER_CONFIRMED=false

# Hosted demo: set AI_PROVIDER=groq with a Groq Free-plan key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FREE_TIER_CONFIRMED=false
